LASO_CONFIG=config/laso.example.yaml
LASO_DATA_DIR=.laso
# Optional; defaults to $LASO_DATA_DIR/artifacts. Use a trusted shared root for
# PostgreSQL multi-instance object-backed workspace transport.
# LASO_ARTIFACT_ROOT=.laso/artifacts
# LASO_MAX_ARTIFACT_BYTES=268435456
# LASO_MAX_ARTIFACT_TEMP_BYTES=536870912
# LASO_ARTIFACT_CLEANUP_GRACE_SECONDS=3600
# Optional authenticated gateway. Set ARTIFACT_SERVICE_PORT on the store owner
# and ARTIFACT_SERVICE_URL/TOKEN on a remote worker; keep the token out of Git.
# LASO_ARTIFACT_SERVICE_HOST=127.0.0.1
# LASO_ARTIFACT_SERVICE_PORT=0
# LASO_ARTIFACT_SERVICE_URL=http://127.0.0.1:9090
# LASO_ARTIFACT_SERVICE_TOKEN=<random-deployment-token>
LASO_LOG_LEVEL=info
LASO_API_HOST=127.0.0.1
LASO_API_PORT=8080
# Optional: explicitly trusted native plugins only.
# LASO_PLUGIN_DIR=build/plugins
# LASO_DB_PATH=.laso/laso.db
# Optional worker budgets (zero disables each budget):
# LASO_MAX_WORKER_WALL_TIME_MS=0
# LASO_MAX_WORKER_TOKENS_PER_RUN=0
# LASO_MAX_WORKER_COST_UNITS_PER_RUN=0
