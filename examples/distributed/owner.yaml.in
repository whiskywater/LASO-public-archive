data_dir: @OWNER_DATA@
storage_backend: postgres
postgres_dsn: "@POSTGRES_DSN@"
postgres_schema: "@POSTGRES_SCHEMA@"
execution_mode: multi_instance
coordination:
  mode: experimental_multi_instance
  lease_ttl_ms: 3000
  heartbeat_interval_ms: 500
workers: 1
max_runs: 4
max_nodes: 8
max_nodes_per_run: 4
max_worker_jobs: 4
max_worker_jobs_per_worker: 1
api_host: 127.0.0.1
api_port: @OWNER_PORT@
artifact_service_host: 127.0.0.1
artifact_service_port: @ARTIFACT_SERVICE_PORT@
artifact_service_token: "@ARTIFACT_SERVICE_TOKEN@"
log_level: warn
json_logs: true
allow_network: false
allow_remote_api: false
policies: []
